# Hébergement mutualisé OVH (Apache) — Yarnest PWA

# Le domaine .app impose HTTPS : on redirige tout accès http.
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Application monopage : toute route inconnue sert index.html (/projects/…, /session…).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Fichiers versionnés par Vite : cache long.
  <FilesMatch "\.(js|css|woff2?|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Point d'entrée et service worker : toujours revalidés, pour que « Nouvelle version » apparaisse.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
